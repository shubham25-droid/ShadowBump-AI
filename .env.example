# ShadowBump AI - Environment Configuration

# Nebius Token Factory Configuration
# Obtain your API token from the Nebius Token Factory / Studio console:
# https://tokenfactory.nebius.com/ or https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for Nebius Token Factory OpenAI-compatible endpoints
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Open-Source Model on Nebius
# Recommended: nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# Alternatives: nvidia/nemotron-mini-4b-instruct, nvidia/nemotron-3-super-120b-a12
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
